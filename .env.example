# Copie para .env.local e preencha. Nunca versione valores reais.
# Em desenvolvimento, os valores vêm da saída de `supabase start`.

# Públicas: vão para o navegador. A proteção dos dados é o RLS, não o sigilo destas chaves.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secretas: somente servidor. Nunca use o prefixo NEXT_PUBLIC_ em uma variável secreta.
# Ignora o RLS. Usada só na exclusão de conta (src/lib/supabase/admin.ts) e pelos testes.
# Em desenvolvimento, é a chave do Supabase local (`supabase status`).
SUPABASE_SECRET_KEY=
